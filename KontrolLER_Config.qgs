        <actionsetting name="Start/stop edit" action="layer = QgsProject.instance().mapLayer('[%@layer_id%]')&#xd;&#xa;&#xd;&#xa;if layer.isEditable():&#xd;&#xa;    qgis.utils.iface.vectorLayerTools().stopEditing(layer,False)&#xd;&#xa;else:&#xd;&#xa;    qgis.utils.iface.setActiveLayer(layer)&#xd;&#xa;    layer.startEditing()" icon="" type="1" isEnabledOnlyWhenEditable="0" id="{5d38b48b-bac5-4ee3-a01d-4f54d7148b74}" shortTitle="" notificationMessage="" capture="0">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting name="Opdatér rapport" action="''' UPDATE REPORT '''&#xd;&#xa;''' Opdatér rapport '''&#xd;&#xa;import psycopg2&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;kontrolGuid = '[%guid%]'&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;layerUriSchema = layerUri.schema()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Import&#xd;&#xa;    dbSql = f'''&#xd;&#xa;&#x9;&#x9;&#x9;UPDATE {layerUriSchema}.kontrol_xml k&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;SET&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;_html_rapport = {layerUriSchema}.kontrol_outputfile('{kontrolGuid}'::uuid)&#xd;&#xa;&#x9;&#x9;&#x9;WHERE k.guid = '{kontrolGuid}'::uuid;&#xd;&#xa;    '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Rapport opdateret&quot;, kontrolGuid, level=Qgis.Info, duration=5)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()&#xd;&#xa;" icon="" type="1" isEnabledOnlyWhenEditable="0" id="{f601a672-9d7a-4b87-8a89-27c95177d138}" shortTitle="Opdatér rapport" notificationMessage="" capture="0">
          <actionScope id="Form"/>
        </actionsetting>
        <actionsetting name="Filtrér lag / Fjern filter" action="''' FILTER LAYER '''&#xd;&#xa;''' Filtrér lag / Fjern filter '''&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;kontrolGuid = '[%guid%]'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;&#xd;&#xa;if layer.subsetString() == '':&#xd;&#xa;    layer.setSubsetString(f'guid = \'{kontrolGuid}\'')&#xd;&#xa;else:&#xd;&#xa;    layer.setSubsetString(None)" icon="" type="1" isEnabledOnlyWhenEditable="0" id="{14d9e2c9-d751-4341-9145-52a5218bf6d8}" shortTitle="Filtrér lag / Fjern filter" notificationMessage="" capture="0">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting name="Åbn rapport" action="''' OPEN REPORT '''&#xd;&#xa;''' Åbn rapport '''&#xd;&#xa;import os&#xd;&#xa;import psycopg2&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;kontrolGuid = '[%guid%]'&#xd;&#xa;&#xd;&#xa;# reportOutput = f'{os.environ['USERPROFILE']}\Desktop\KontrolLER.html'&#xd;&#xa;reportOutput = f'{os.environ['TEMP']}\KontrolLER.html'&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;layerUriSchema = layerUri.schema()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    dbSql = f'''&#xd;&#xa;&#x9;&#x9;&#x9;SELECT&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;k._html_rapport&#xd;&#xa;&#x9;&#x9;&#x9;FROM {layerUriSchema}.kontrol_xml k&#xd;&#xa;&#x9;&#x9;&#x9;WHERE k.guid = '{kontrolGuid}'::uuid;&#xd;&#xa;    '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;    htmlReport = dbCursor.fetchone()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    if htmlReport[0] is None:&#xd;&#xa;&#xd;&#xa;        dbSqlUpt = f'''&#xd;&#xa;                UPDATE {layerUriSchema}.kontrol_xml k&#xd;&#xa;                    SET&#xd;&#xa;                        _html_rapport = {layerUriSchema}.kontrol_outputfile('{kontrolGuid}'::uuid)&#xd;&#xa;                WHERE k.guid = '{kontrolGuid}'::uuid;&#xd;&#xa;        '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        dbCursor.execute(dbSqlUpt)&#xd;&#xa;        dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        dbCursor.execute(dbSql)&#xd;&#xa;        dbConnection.commit()&#xd;&#xa;&#xd;&#xa;        htmlReport = dbCursor.fetchone()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    with open(reportOutput, &quot;w&quot;, encoding=&quot;utf-8&quot;) as f:&#xd;&#xa;        f.write(htmlReport[0])&#xd;&#xa;&#xd;&#xa;        os.startfile(reportOutput)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()&#xd;&#xa;" icon="" type="1" isEnabledOnlyWhenEditable="0" id="{c13e5ed7-3fa1-429f-ab93-29f348797f70}" shortTitle="Åbn rapport" notificationMessage="" capture="0">
          <actionScope id="Feature"/>
          <actionScope id="Form"/>
        </actionsetting>
        <actionsetting name="Indlæs data" action="''' LOAD DATA '''&#xd;&#xa;''' Indlæs data '''&#xd;&#xa;import psycopg2&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;    ,QgsVectorLayer&#xd;&#xa;    ,QgsDataSourceUri&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;kontrolGuid = '[%guid%]'&#xd;&#xa;kontrolGroup = '''[%format_date(&quot;datooprettet&quot;, 'dd-MM-yyyy HH:mm') || ' | ' || COALESCE(&quot;titel&quot; || ' (' || &quot;guid&quot; || ')', &quot;guid&quot;)%]'''&#xd;&#xa;&#xd;&#xa;# layerId = 'kontrol_xml_7e0cae27_d5a3_4ee5_9dda_e9a9e2ab9ff3'&#xd;&#xa;# kontrolGuid = 'c09026d6-77d9-4034-8a6c-72b05e550681'&#xd;&#xa;# kontrolGroup = '12-01-2026 08:38 | c09026d6-77d9-4034-8a6c-72b05e550681'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;layerUriSchema = layerUri.schema()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Find data&#xd;&#xa;    dbSql = f'''SELECT&#xd;&#xa;                    table_name&#xd;&#xa;                    ,layer_title_pretty&#xd;&#xa;                FROM {layerUriSchema}.kontrol_inputfiles_features_qgis('{kontrolGuid}'::uuid);'''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbResult = dbCursor.fetchall()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    if dbResult == []:&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Ingen data fundet&quot;, None, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;    # Data found, continue&#xd;&#xa;    else:&#xd;&#xa;        layerRoot = QgsProject.instance().layerTreeRoot()&#xd;&#xa;        layerGroup = QgsLayerTreeGroup(kontrolGroup)&#xd;&#xa;        layerGroupPosition = 0&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        layerRoot.insertChildNode(layerGroupPosition, layerGroup)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        for i in dbResult:&#xd;&#xa;            dsTableName = i[0]&#xd;&#xa;            dsLayerName = i[1]&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            dsUri = QgsDataSourceUri()&#xd;&#xa;            dsUri.setConnection(&#xd;&#xa;                layerUriHost&#xd;&#xa;                ,layerUriPort&#xd;&#xa;                ,layerUriDatabase&#xd;&#xa;                ,layerUriUser&#xd;&#xa;                ,layerUriPw&#xd;&#xa;            )&#xd;&#xa;&#xd;&#xa;            dsUri.setDataSource(&#xd;&#xa;                layerUriSchema&#xd;&#xa;                ,dsTableName&#xd;&#xa;                ,'geom'&#xd;&#xa;                ,None&#xd;&#xa;                ,'feature_fid'&#xd;&#xa;            )&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            dsLayer = QgsVectorLayer(dsUri.uri(False), dsLayerName, layer.dataProvider().name())&#xd;&#xa;            dsMemoryLayer = dsLayer.materialize(QgsFeatureRequest().setFilterFids(dsLayer.allFeatureIds()))&#xd;&#xa;            QgsProject.instance().addMapLayer(dsMemoryLayer, False)&#xd;&#xa;            layerGroup.addLayer(dsMemoryLayer)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        # Find data&#xd;&#xa;        dbSql = f'''SELECT {layerUriSchema}.kontrol_inputfiles_features_qgis_clear('{kontrolGuid}'::uuid);'''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        dbCursor.execute(dbSql)&#xd;&#xa;        dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Data indlæst&quot;, None, level=Qgis.Info, duration=5)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()&#xd;&#xa;" icon="" type="1" isEnabledOnlyWhenEditable="0" id="{70c7f6a3-ecb8-4b22-b7a1-8cf27d52b5a0}" shortTitle="Indlæs data" notificationMessage="" capture="0">
          <actionScope id="Feature"/>
          <actionScope id="Form"/>
        </actionsetting>
      </attributeactions>
